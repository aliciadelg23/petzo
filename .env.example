# =============================================================================
# Petzo — variáveis de ambiente do docker-compose
# =============================================================================
# Copie para `.env` na raiz do repo (git-ignored). Não commitar valores reais.
#
# Este arquivo é lido apenas pelo `docker-compose.yml` (stack completa).
# Para rodar API/Web fora do Docker, cada app tem seu próprio .env.example.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=petzo
POSTGRES_PASSWORD=change-me-in-real-envs
POSTGRES_DB=petzo
POSTGRES_HOST_PORT=5433

# --- Redis -------------------------------------------------------------------
REDIS_HOST_PORT=6380

# --- API ---------------------------------------------------------------------
API_HOST_PORT=3333
NODE_ENV=production

# Connection strings (usam nomes dos services da rede interna do compose)
DATABASE_URL=postgresql://petzo:change-me-in-real-envs@postgres:5432/petzo
REDIS_URL=redis://redis:6379

# JWT — usar segredos de 32+ chars aleatórios em ambientes reais
# gerar com:  openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-not-secure-please-rotate-in-real-environments
JWT_REFRESH_SECRET=dev-only-not-secure-please-rotate-in-real-environments
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS (múltiplas origens separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# Cache
CACHE_ENABLED=true

# Log level (silent | fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# --- Web ---------------------------------------------------------------------
WEB_HOST_PORT=3000
# URL da API vista pelo browser (host) — não a URL interna do compose.
NEXT_PUBLIC_API_URL=http://localhost:3333
