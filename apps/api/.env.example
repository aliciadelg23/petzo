# Ambiente
NODE_ENV=development
LOG_LEVEL=info

# Server
API_PORT=3333
API_HOST=0.0.0.0

# CORS: origem do front-end web (Next.js). Múltiplas separadas por vírgula.
CORS_ORIGINS=http://localhost:3000

# Postgres (Prisma)
DATABASE_URL=postgresql://petzo:petzo@localhost:5432/petzo

# Redis (uso futuro em cache/queue)
REDIS_URL=redis://localhost:6379

# JWT (usados na fase de auth)
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
